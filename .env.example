# Which telemetry API client to use — see src/api/telemetryApi.ts.
#   real (default) — the FastAPI backend in ../backend
#   mock           — a self-contained in-memory fake, no backend required
# VITE_API_MODE=mock

# Base URL for the real API (VITE_API_MODE=real only). Defaults to
# http://localhost:3000. The backend enables CORS, so the browser calls it
# directly.
# VITE_API_BASE_URL=http://localhost:3000
