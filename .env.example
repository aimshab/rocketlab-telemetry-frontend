# Which telemetry API client to use — see src/api/telemetryApi.ts.
#   real (default) — the FastAPI backend in ../backend, via the Vite dev proxy
#   mock           — a self-contained in-memory fake, no backend required
# VITE_API_MODE=mock

# Optional (VITE_API_MODE=real only): call the API at this base URL directly
# instead of going through the Vite dev proxy. Only useful if that host sends
# CORS headers.
# VITE_API_BASE_URL=http://localhost:3000
